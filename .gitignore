# =====================================================
# IGNORE EVERYTHING IN THIS PROJECT
# =====================================================
*

# =====================================================
# ALLOW ONLY YOUR CUSTOM THEME
# =====================================================
!wp-content/
!wp-content/themes/
!wp-content/themes/myidealfranchise/
!wp-content/themes/myidealfranchise/**

# =====================================================
# ALLOW GIT SYSTEM FILES
# =====================================================
!.gitignore
!README.md

# =====================================================
# IGNORE EVERYTHING ELSE INSIDE WP-CONTENT
# =====================================================
wp-content/plugins/
wp-content/uploads/
wp-content/cache/
wp-content/litespeed/
wp-content/wpvivid_staging/
wp-content/wpvividbackups/
wp-content/*.php

# =====================================================
# IGNORE WORDPRESS CORE
# =====================================================
wp-admin/
wp-includes/
wp-*.php
xmlrpc.php
/index.php
readme.html
license.txt
.htaccess

# =====================================================
# IGNORE ENV & SYSTEM FILES
# =====================================================
*.log
*.zip
*.tar
*.tar.gz
*.sql
*.db
vendor/
node_modules/
.env
.DS_Store
Thumbs.db